rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn();
      // Everyone starts as a regular user; admins are promoted in the Firebase console.
      allow create: if request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if (request.auth.uid == uid && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    match /seasons/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /attendees/{attendeeId} {
        allow read: if signedIn();
        // A user can sign up themself or another registered player (doc id = their uid),
        // or add guests without an account on their own behalf.
        allow create: if isAdmin() || (
          request.resource.data.addedBy == request.auth.uid &&
          (
            (request.resource.data.kind == 'user' && request.resource.data.uid == attendeeId &&
              exists(/databases/$(database)/documents/users/$(attendeeId))) ||
            (request.resource.data.kind == 'guest' && request.resource.data.uid == null)
          ) &&
          get(/databases/$(database)/documents/events/$(eventId)).data.status == 'open'
        );
        // The person who added the entry, or the player themself, can remove it.
        allow delete: if isAdmin() || ((resource.data.addedBy == request.auth.uid || attendeeId == request.auth.uid) &&
          get(/databases/$(database)/documents/events/$(eventId)).data.status == 'open');
        allow update: if isAdmin();
      }
    }
  }
}
